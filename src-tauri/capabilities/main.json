    "allow-risk-status",
    "allow-strategy-arm",
    "allow-strategy-disarm",
    "allow-paper-start",
    "allow-paper-states",
    "allow-paper-stop",
    "allow-strategies",
    "allow-strategy-delete",
    "allow-strategy-save",
    "allow-broker-demo",
    "allow-broker-login",
    "allow-broker-logout",
    "allow-broker-setup",
    "allow-broker-funds",
    "allow-broker-holdings",
    "allow-broker-orders",
    "allow-broker-positions",
    "allow-broker-status",
    "allow-broker-trades",
