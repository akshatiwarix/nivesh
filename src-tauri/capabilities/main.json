{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window. Grants only Nivesh's own commands; the only core permissions are listening to (not emitting) events.",
  "windows": ["main"],
  "permissions": [
    "allow-all-indices",
    "allow-app-info",
    "allow-chart-indicators",
    "allow-compute-indicators",
    "allow-get-history",
    "allow-get-movers",
    "allow-get-quote",
    "allow-index-snapshot",
    "allow-market-status",
    "allow-provider-status",
    "allow-save-chart-indicators",
    "allow-search-instruments",
    "allow-set-window-visible",
    "allow-subscribe-forming-bar",
    "allow-subscribe-quotes",
    "allow-unsubscribe",
    "allow-watchlist-activate",
    "allow-watchlist-add",
    "allow-watchlist-create",
    "allow-watchlist-delete",
    "allow-watchlist-move",
    "allow-watchlist-remove",
    "allow-watchlist-rename",
    "allow-watchlists",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ui-state",
    "allow-save-layout",
    "allow-save-command-history"
  ]
}
